# Copy to .env on the deployment server; never commit the filled file.
VIDEO_AGENT_ENV=production
VIDEO_AGENT_EMBEDDED_WORKER=0
VIDEO_AGENT_DATA=/data
VIDEO_AGENT_COOKIE_SECURE=1
VIDEO_AGENT_PUBLIC_URL=https://video.example.com
VIDEO_AGENT_MEDIA_BASE_URL=https://media.example.com
APP_HOST=video.example.com
MEDIA_HOST=media.example.com
VIDEO_AGENT_SESSION_SECRET=
POSTGRES_PASSWORD=
ARK_API_KEY=
AUTODL_API_KEY=
# Optional exact hosts to reach directly when the machine proxy is unreliable.
# Leave empty on deployment unless connection tests justify an explicit bypass.
VIDEO_AGENT_PROXY_BYPASS_HOSTS=
VIDEO_AGENT_DAILY_SECONDS=600
# Per-account generated seconds, including repairs and uncertain submissions.
VIDEO_AGENT_DAILY_GENERATION_SECONDS=600
# Stop new paid submissions when this many receipts remain uncertain.
VIDEO_AGENT_MAX_UNCERTAIN_SUBMISSIONS=5
VIDEO_AGENT_CONCURRENT_JOBS=2
VIDEO_AGENT_USER_CONCURRENT=1
VIDEO_AGENT_REMOTE_CONCURRENT=2
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VIDEO_AGENT_CHROME_PATH=/usr/bin/chromium

# Optional administrator-approved whole-film music library.
# catalog.json and audio files must be in this persistent directory.
VIDEO_AGENT_MUSIC_DIRECTORY=/data/music-library
# Optional per-job generation-seconds cap; otherwise max(30, 2 * film seconds).
# This is a local quota, NOT the provider's monetary balance.
# VIDEO_AGENT_JOB_SECONDS=120
